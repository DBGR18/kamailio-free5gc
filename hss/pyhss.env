# PyHSS configuration.
#
# PyHSS is configured entirely through the environment; there is no config
# file to mount. Only the values this PoC actually depends on are listed --
# everything else keeps PyHSS's own defaults.
#
# Why PyHSS and not Open5GS's HSS, which also implements Cx: the reference
# Kamailio IMS deployment (herlesupreeth/docker_open5gs) points its I-CSCF
# and S-CSCF at PyHSS, so when the Cx handshake misbehaves there is a known
# working configuration to compare against. That matters more than the two
# containers it costs.

# ---------------------------------------------------------------- Diameter
HSS_TRANSPORT=TCP
HSS_BIND_IP=0.0.0.0
HSS_BIND_PORT=3868

# The Diameter identity and realm follow the 3GPP naming rule for PLMN
# 208/93, which is also how the UE derives its IMPI from its IMSI when there
# is no ISIM (TS 23.003 13.4B):
#   IMSI 208930000000001
#     -> IMPI 208930000000001@ims.mnc093.mcc208.3gppnetwork.org
HSS_ORIGIN_HOST=hss.ims.mnc093.mcc208.3gppnetwork.org
HSS_ORIGIN_REALM=ims.mnc093.mcc208.3gppnetwork.org
HSS_MCC=208
HSS_MNC=93

# The Server-Name the HSS hands back in a User-Authorization-Answer, which
# is how the I-CSCF learns which S-CSCF to route a registration to. It must
# be a full SIP URI: the I-CSCF puts the value straight into the request
# destination, and a bare hostname fails with "bad_uri" and a 500. PyHSS's
# own default is a bare hostname, so this is not a copy of it.
#
# The value must also match icscf/seed.sql's s_cscf_uri and the S-CSCF's
# own scscf_name.
HSS_SCSCF_POOL=sip:scscf.ims.mnc093.mcc208.3gppnetwork.org:6060

HSS_PRODUCT_NAME=pyHSS
HSS_SEND_DWR=False
HSS_LOCK_PROVISIONING=False
HSS_ROAMING_ALLOW_UNDEFINED_NETWORKS=True

# ------------------------------------------------------------- provisioning
API_BIND_IP=0.0.0.0
API_BIND_PORT=8080

# ---------------------------------------------------------------- storage
# SQLite on a shared volume: no separate database container, and the file is
# the only thing that has to persist.
DATABASE_TYPE=sqlite
DATABASE_NAME=/var/lib/pyhss/hss.db

REDIS_CONNECTION_TYPE=tcp
REDIS_HOST=pyhss-redis
REDIS_PORT=6379

# ------------------------------------------------------------------- misc
LOGGING_LEVEL=INFO
GEORED_ENABLED=False
WEBHOOKS_ENABLED=False
OCS_ENABLED=False
INFLUXDB_ENABLED=False
BENCHMARKING_ENABLED=False
